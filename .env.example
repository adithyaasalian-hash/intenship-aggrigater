# Copy to .env. Every value below has a working default, so `docker compose up`
# runs with this file untouched. Change JWT_SECRET before you deploy anywhere.

# --- required in production -------------------------------------------------
JWT_SECRET=dev-only-change-me
ADMIN_KEY=dev-admin-key
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
MONGO_DB=internships

# --- ingestion --------------------------------------------------------------
# Runs on boot only when the database is empty, then on this schedule.
INGEST_ON_BOOT=true
INGEST_CRON=0 */6 * * *

# Adzuna is the only source that needs a key. Free tier is roughly 1,000 calls
# a month. Register at https://developer.adzuna.com -- takes about a minute.
# Leave blank and the adapter simply stays disabled.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Keyless, unlimited, per company. Find the token in a company's careers URL:
#   boards.greenhouse.io/<token>   ->   GREENHOUSE_BOARDS=token1,token2
#   jobs.lever.co/<token>          ->   LEVER_BOARDS=token1,token2
# Curate 20-30 companies your judges will recognise. This is the cheapest way
# to make the feed look real.
GREENHOUSE_BOARDS=
LEVER_BOARDS=

# --- ml ---------------------------------------------------------------------
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOG_LEVEL=INFO

# Scoring weights. These are a considered prior, not a fitted result -- see the
# README before changing them, and be ready to defend whatever you pick.
# W_SKILLS=0.45
# W_SEMANTIC=0.25
# W_SENIORITY=0.12
# W_LOCATION=0.10
# W_FRESHNESS=0.08
